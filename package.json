{
  "name": "wbf-docs",
  "version": "1.0.0",
  "description": "WBF Internal Documentation and Knowledge Base",
  "author": {
    "name": "WBF"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wprettymanwbf/wise-docs.git"
  },
  "scripts": {
    "check-lfs": "node ./build/check-lfs.js",
    "lint": "eslint **/*.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "eslint-plugin-security": "^1.7.1",
    "gulp": "~5.0.0",
    "husky": "^7.0.0",
    "lint-staged": "^12.3.3",
    "shelljs": "^0.8.5"
  },
  "lint-staged": {
    "*.{gif,mp4,jpg,png,GIF,MP4,JPG,PNG}": [
      "npm run check-lfs"
    ]
  }
}
